# Postgres (used by docker-compose and the API)
POSTGRES_USER=turn
POSTGRES_PASSWORD=turn
POSTGRES_DB=turnapp
POSTGRES_PORT=5432

# API
DATABASE_URL=postgresql://turn:turn@localhost:5432/turnapp?schema=public
JWT_SECRET=dev-super-secret-change-me
PORT=4000
# Only used for the API's startup log line. The mobile app auto-detects the host
# from the Expo dev server, and the admin uses its own VITE_API_URL, so you do NOT
# need to change this to run on a physical phone.
PUBLIC_API_URL=http://localhost:4000
