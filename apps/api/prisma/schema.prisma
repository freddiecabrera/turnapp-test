generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String  @id @default(cuid())
  username     String  @unique
  email        String  @unique
  passwordHash String
  userIdNumber Int     @unique
  pointsBalance Int    @default(0)
  isAdmin      Boolean @default(false)

  cards        UserCard[]
  transactions PointsTransaction[]
  scannedCodes QrCode[]

  tradesSent     Trade[] @relation("TradesSent")
  tradesReceived Trade[] @relation("TradesReceived")

  createdAt DateTime @default(now())
}

model Season {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  cards Card[]
}

model Card {
  id              String  @id @default(cuid())
  name            String
  type            String?
  universe        String?
  rarity          String?
  rarityLevel     Int?
  cardNumber      String?
  story           String?
  imageUrl        String?

  season   Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  seasonId String

  owners  UserCard[]
  qrCodes QrCode[]

  tradesOffered   Trade[] @relation("TradesOffered")
  tradesRequested Trade[] @relation("TradesRequested")

  createdAt DateTime @default(now())
}

model UserCard {
  id             String   @id @default(cuid())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  card           Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  cardId         String
  quantity       Int      @default(1)
  firstScannedAt DateTime @default(now())

  @@unique([userId, cardId])
}

model PointsTransaction {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  amount      Int
  description String
  createdAt   DateTime @default(now())
}

// A single-use QR code that, when scanned, grants a card + points to a user.
model QrCode {
  id            String    @id @default(cuid())
  code          String    @unique
  card          Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  cardId        String
  pointsAwarded Int       @default(50)
  batchId       String?
  batchLabel    String?
  scannedByUser User?     @relation(fields: [scannedByUserId], references: [id])
  scannedByUserId String?
  scannedAt     DateTime?
  createdAt     DateTime  @default(now())

  @@index([batchId])
}

enum TradeStatus {
  PENDING
  ACCEPTED
  DECLINED
}

// A single-card-for-single-card trade request between two users. Cards only
// move when the recipient accepts.
//
// This references Card rather than UserCard on purpose. UserCard stores a
// quantity, not per-copy rows, so there is no individual card to point at —
// and its row is deleted when the last copy leaves, which would drag trade
// history with it. Ownership is therefore verified inside the accept
// transaction rather than guaranteed by a foreign key. See DESIGN.md.
//
// "offered" is always relative to fromUser. The API layer tags each trade with
// a viewer-relative direction so clients never have to invert it themselves.
model Trade {
  id              String      @id @default(cuid())

  fromUser        User        @relation("TradesSent", fields: [fromUserId], references: [id], onDelete: Cascade)
  fromUserId      String
  toUser          User        @relation("TradesReceived", fields: [toUserId], references: [id], onDelete: Cascade)
  toUserId        String

  offeredCard     Card        @relation("TradesOffered", fields: [offeredCardId], references: [id], onDelete: Cascade)
  offeredCardId   String
  requestedCard   Card        @relation("TradesRequested", fields: [requestedCardId], references: [id], onDelete: Cascade)
  requestedCardId String

  status          TradeStatus @default(PENDING)

  createdAt       DateTime    @default(now())
  respondedAt     DateTime?

  // The board's only two queries: my incoming and my outgoing, by status.
  @@index([toUserId, status])
  @@index([fromUserId, status])
  // A partial unique index preventing duplicate PENDING trades is appended as
  // raw SQL in the migration — Prisma has no syntax for partial indexes.
}
